section .header
    arch: 64

section .data ; Dunno how to use these.
    ONE: 1
    TEN: 10

section .text ; Cool comment
_start:
    ldi r1, 0x14
    ldi r2, 10
    str r2, [r1]
    load r3, [r1 + 20]
    ldi r5, 10 ; repeat 10 times
    cmp r3, r2
    JZ loop
    jmp 0x34
loop:
    xor r4, r4, r4
    ; Do some instructions
    inc r4
    cmp r4, r5
    jz loop
_end: 
    HLT
