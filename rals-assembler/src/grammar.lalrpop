use crate::ast::*;
use crate::lexer::{Token, LexError, SpecialRegister};

grammar;

extern {
    type Location = usize;
    type Error = LexError;

    enum Token {
        "section" => Token::Section,
        "dotident" => Token::DotIdent(<String>),
        ":" => Token::Colon,
        "," => Token::Comma,
        "[" => Token::LBracket,
        "]" => Token::RBracket,
        "+" => Token::Plus,
        "-" => Token::Minus,
        "*" => Token::Asterisk,
        "sreg" => Token::SpecialReg(<SpecialRegister>),
        "reg" => Token::Register(<u8>),
        "imm" => Token::Immediate(<i64>),
        "ident" => Token::Ident(<String>),
        "\n" => Token::Newline,
    }
}

pub Program: AstProgram = {
    "\n"* <sections:Section*> => AstProgram { sections }
};

Section: AstSection = {
    <start:@L> "section" <name:"dotident"> "\n"+ <items:Item*> <end: @R>
        => AstSection { name, items, span: start..end }
};

Item: AstItem = {
    <start: @L><name:"ident"> ":" <value:"imm"?> "\n"+ <end: @R> => match value {
        Some(v) => AstItem::Directive { 
            key: name,
            value: v,
            span: start..end
        },
        None => AstItem::Label {
            name, span: start..end
        },
    },
    <i:Instruction> "\n"+ => AstItem::Instruction(i),
};

Instruction: AstInstruction = {
    <start: @L> <m:"ident"> <ops:Comma<Operand>> <end: @R> => AstInstruction { 
        mnemonic: m,
        operands: ops,
        span: start..end
    },
};

Operand: AstOperand = {
    <sr: "sreg"> => AstOperand::SReg(sr),
    <r: "reg"> => AstOperand::Reg(r),
    <i: "imm"> => AstOperand::Imm(i),
    <l: "ident"> => AstOperand::Label(l),
    "[" <base:"reg"> <index: DerefIndex?> <scale: DerefScale?> <displacement: DerefDisplacement?> "]" 
        => {
        if let Some(_) = scale {
            panic!("using scale operations on deref expression are not supported")
        }

        AstOperand::Deref {
            base,
            index: index.unwrap_or(0),
            displacement: displacement.unwrap_or(0)
        }
    },
};

DerefIndex: u8 = {
    "+" <r: "reg"> => r,
};

DerefScale: i64 = {
    "*" <i: "imm"> => i,
};

DerefDisplacement: i64 = {
    "+" <i: "imm"> => i,
    "-" <i: "imm"> => -i,
};

// Standard lalrpop idiom for comma-separated lists — no left-recursion,
// no ambiguity with the empty case.
Comma<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => { v.push(e); v }
    }
};
