section .header 
arch: 8

section .text
_start:
    ldi     r1, 0d6
    ldi     r2, 0d20
    call    add
    jmp     _end

add:
    add     r1, r2, r1
    ldi     r3, 0xff

    mov     rfp, rsp
    mov     r15, rsp
    push    r15
    ldi     r4, 0d4
    push    r4

    mov     rsp, rfp
    ret
    
_end:
    hlt
