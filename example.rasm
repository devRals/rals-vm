section .header 
arch: 8

section .text
_start:
    ldi     r1, 0d6
    ldi     r2, 0d20
    call    add
    jmp     _end

add:
    add     r1, r2, r1
    ldi     r3, 0xff

    mov     rfp, rsp
    push    r1
    push    r3
    ; Do stuf with stack
    ; ...
    ; ...
    mov     rsp, rfp ; Dealloc stuff from stack
    ret
    
_end:
    hlt
